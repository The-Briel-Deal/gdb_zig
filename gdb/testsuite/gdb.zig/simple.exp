load_lib zig-support.exp
require {can_compile zig}
standard_testfile .zig

if { [prepare_for_testing "failed to prepare" \
	${testfile} ${srcfile} "zig"] } {
    return
}

if {![runto ${srcfile}:3]} {
    untested "could not run to breakpoint"
    return -1
}

# For some reason I can't get '\003' to match, I wonder if \ is the regex delimiter?
gdb_test "print a" {= 3 '\\003'}
